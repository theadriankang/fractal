# Copy to backend/.env and fill in. backend/.env is git-ignored.

# Supabase Postgres — Session pooler connection string
# (Supabase Dashboard → Settings → Database → Connection string → Session pooler)
DATABASE_URL=
# Supabase project URL + service role key (for Admin API calls in seed.py)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for Claude chat (backend/app/llm/claude.py)
ANTHROPIC_API_KEY=
# Thinking depth for chat answers: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
# Know-how capture from chat (optional overrides)
# EXTRACTION_MODEL=claude-haiku-5-5
# EXTRACTION_THRESHOLD=0.6

# CORS (defaults to http://localhost:5173 if unset)
# CORS_ORIGINS=["http://localhost:5173"]
