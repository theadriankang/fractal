# Copy to backend/.env and fill in. backend/.env is git-ignored.

# Supabase Postgres — Session pooler connection string
# (Supabase Dashboard → Settings → Database → Connection string → Session pooler)
DATABASE_URL=
# Supabase project URL + service role key (for Admin API calls in seed.py)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for Claude chat (backend/app/llm/claude.py)
ANTHROPIC_API_KEY=
# Thinking depth for chat answers: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
# Know-how capture from chat (optional overrides)
# EXTRACTION_MODEL=claude-haiku-5-5
# EXTRACTION_THRESHOLD=0.6

# Multi-model routing (backend/app/llm/registry.py)
# OpenRouter key — serves all non-Claude models (GPT, Gemini, Grok, DeepSeek,
# and Hunyuan when the Hunyuan override below is not set).
OPENROUTER_API_KEY=
# Hunyuan OpenAI-compatible endpoint override. When both are set, Hunyuan
# models (hunyuan-t1, hunyuan-turbos) go direct instead of via OpenRouter.
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=

# Semantic retrieval (default: local fastembed, no API key)
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=  # for litellm, e.g. text-embedding-3-small

# CORS (defaults to http://localhost:5173 if unset)
# CORS_ORIGINS=["http://localhost:5173"]
