# Copy to .env.local — the Meeting Recorder requires Supabase.
# Project "fractal-meetings": Supabase dashboard → Project Settings → API (use the legacy "anon" key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# true = run the whole UI on mock data (on-stage fallback). Otherwise Claude
# models are answered by the FastAPI backend in /backend.
VITE_USE_MOCK=false
